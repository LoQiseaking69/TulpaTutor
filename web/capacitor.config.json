{
  "appId": "dev.hermitech.tulpatutor",
  "appName": "TulpaTutor",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "android": {
    "path": "../android",
    "backgroundColor": "#000000"
  },
  "ios": {
    "path": "../ios",
    "backgroundColor": "#000000",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#000000",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#040a1c"
    }
  }
}
